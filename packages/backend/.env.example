# Backend configuration — copy to .env and edit as needed.
# This file is committed; .env is gitignored.

# Postgres connection string. Matches docker-compose.dev.yml defaults.
DATABASE_URL=postgres://emr:emr@localhost:5432/emr

# HTTP port. Controller-assigned slot for this project.
PORT=5210

# CORS allow-list for the frontend (Vite dev server).
FRONTEND_ORIGIN=http://localhost:5209

# JWT signing — HS256 dev secret. In production, switch to RS256 with a
# keypair (jose.importPKCS8 / importSPKI). Rotate by changing the secret
# and invalidating live tokens via the sessions table.
JWT_SECRET=dev-only-change-me-min-32-bytes-please

# Access token TTL (seconds). 15 minutes is the proposed default.
JWT_ACCESS_TTL_SECONDS=900

# Refresh token TTL (seconds). 30 days.
JWT_REFRESH_TTL_SECONDS=2592000

# Log level: error | warn | info | debug | trace
LOG_LEVEL=info
