{
  "name": "@emr/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["src", "dist", "migrations"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "lint": "eslint src test --ext .ts --max-warnings 0",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "node-pg-migrate --migration-file-language sql --migrations-dir migrations --database-url-var DATABASE_URL up",
    "db:migrate:down": "node-pg-migrate --migration-file-language sql --migrations-dir migrations --database-url-var DATABASE_URL down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d && sleep 3 && pnpm db:migrate"
  },
  "dependencies": {
    "@emr/contracts": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.6.0",
    "argon2": "^0.40.3",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "jose": "^5.6.3",
    "kysely": "^0.27.4",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.11.6",
    "node-pg-migrate": "^7.6.1",
    "tsx": "^4.19.2",
    "vitest": "^1.6.0"
  }
}
